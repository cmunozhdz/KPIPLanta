# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API Base URL para Servicios REST
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"
VITE_API_URL="https://serviciosrest.polakgrupo.com/Kiosco/Apis/IntranetSeguridad"
VITE_API_URL_SEG="https://serviciosrest.polakgrupo.com/Kiosco/Apis/IntranetSeguridad"
VITE_APIS_PLANTA="https://serviciosrest.polakgrupo.com/Kiosco/Apis/Planta"
VITE_API_HISTORICO="https://serviciosrest.polakgrupo.com/Kiosco/IAPlanta/AreaKPIHistoricoAPI/area_kpihistoricoes"
VITE_API_KPI="https://serviciosrest.polakgrupo.com/Kiosco/IAPlanta/AreaKPIAPI/area_kpis"
VITE_API_EXOP_URL="https://serviciosrest.polakgrupo.com/kiosco/Apis/IntranetSeguridad/Modulo/ExOP"
VITE_API_AREAS_ADMIN="https://serviciosrest.polakgrupo.com/Kiosco/Apis/Planta/AreasLista/Admin"
VITE_URL_MANUAL_USUARIO="https://docs.google.com/document/d/1c4vjpJUuu60J6HiVSXdx58YGVvdQgK7BRzh_cO_sOdA/edit?usp=sharing"
VITE_URL_SOPORTE_TI="https://docs.google.com/forms/d/e/1FAIpQLSfdgYDGU6-BmZ-nkTV6B2Z5UdbNtzwu8M5maMkbcsTEMJNfYw/viewform"
