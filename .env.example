# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Identity Services Client ID
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID"

# API Host Base para Servicios REST
VITE_API_HOST="https://serviciosrest.polakgrupo.com"

# API Proxy Target para Servidor de Desarrollo
VITE_PROXY_TARGET="https://serviciosrest.polakgrupo.com"

# Contexto Dinámico de Kiosco:
# Use "Kiosco" para la planta general / estándar
# Use "KioscoDJP" para la planta DJP
VITE_KIOSCO_CONTEXT="Kiosco"

# Sobrescrituras opcionales de endpoints específicos (si se dejan vacías, se generan automáticamente con VITE_KIOSCO_CONTEXT)
