// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "TableroPlanta",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"runArgs": [
		"--name",
		"TableroPlanta"
	],
	"forwardPorts": [
		3000
	],
	"portsAttributes": {
		"3000": {
			"label": "Aplicación Web",
			"hostPort": 3001,
			"onAutoForward": "notify"
		}
	},
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/node/.gitconfig,type=bind,consistency=cached",
		// Esto asegura que el volumen nombrado absorba por completo los node_modules
		"source=tablero-planta-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
	],
	// Cambiado a updateContentCommand para evitar reinstalaciones innecesarias
	"updateContentCommand": "npm install",
	"customizations": {
		"vscode": {
			"extensions": [
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"GitHub.vscode-pull-request-github",
				"bradlc.vscode-tailwindcss",
				"dsznajder.es7-react-js-snippets"
			],
			"settings": {
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll.eslint": "explicit"
				}
			}
		}
	},
	"remoteUser": "node"
}